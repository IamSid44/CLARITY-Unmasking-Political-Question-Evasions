# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Every run re-reads this file at start-up, so keys added mid-pipeline take
# effect from the next run. Empty values mean "not set".

# --- Weights & Biases -------------------------------------------------------
# Without a key, runs log OFFLINE to clarity/wandb/; upload later with:
#   wandb sync clarity/wandb/offline-run-*
WANDB_API_KEY=
WANDB_PROJECT=clarity-semeval26
WANDB_ENTITY=

# --- Hugging Face Hub --------------------------------------------------------
# Selected checkpoints (bf16) + metrics + probabilities are uploaded to a PRIVATE
# model repo, one folder per run: <HF_REPO_ID>/<config>/<seed>/
# Without these, uploads are skipped; push later with:
#   python tracking.py push runs/<config>
HF_TOKEN=
HF_REPO_ID=your-hf-username/clarity-semeval26
# Xet uploads stall on this server; classic LFS works (see tracking.py)
HF_HUB_DISABLE_XET=1
